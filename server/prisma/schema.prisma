generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================
// ENUMS
// ===================================

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN_HR
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ===================================
// CORE MODELS
// ===================================

model User {
  id           String    @id @default(uuid())
  employeeId   String    @unique
  name         String
  email        String    @unique
  passwordHash String
  position     String?
  department   String?
  role         Role
  status       String?   @default("Active")
  hireDate     DateTime? @db.Timestamptz()
  nid          String? // National ID or SSN

  bankDetails String? // For payroll purposes

  settings EmployeeSettings?

  // --- Relational Fields for Hierarchy ---
  managerId String? // ID of the manager
  manager   User?   @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees User[]  @relation("ManagerEmployees") // Employees reporting to this user

  // --- System/Attendance Fields ---
  avatar            String?
  attendanceRecords AttendanceRecord[]
  approvalRequests  ApprovalRequest[]
  leaveRequests     LeaveRequest[] // For leave management
  auditLogs         AuditLog[] // Track actions taken by this user
}

model EmployeeSettings {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  timezone         String    @default("Asia/Karachi")
  breakType        String?   @default("DEFAULT") // "DEFAULT" or "CUSTOM"
  customBreakStart DateTime? @db.Timestamptz() // Time part only
  customBreakEnd   DateTime? @db.Timestamptz() // Time part only
}

model AttendanceRecord {
  id         String              @id @default(uuid())
  employeeId String
  employee   User                @relation(fields: [employeeId], references: [id])
  date       DateTime            @default(now()) @db.Date
  status     String              @default("Present")
  breakStart DateTime?           @db.Timestamptz() // Break start time
  breakEnd   DateTime?           @db.Timestamptz() // Break end time
  breakHours Float?
  totalHours Float?
  sessions   AttendanceSession[]

  @@unique([employeeId, date], name: "unique_attendance_per_day")
}

model AttendanceSession {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  checkIn            DateTime         @default(now()) @db.Timestamptz()
  checkOut           DateTime?        @db.Timestamptz()
  location           String? // "Office", "Home", etc.
  type               String           @default("WORK") // "WORK", "BREAK"
}

model ApprovalRequest {
  id         String   @id @default(uuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id])
  type       String
  date       DateTime @db.Timestamptz()
  details    String?
  status     String
}

// --- Leave Management Models ---
model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String
  employee        User        @relation(fields: [employeeId], references: [id])
  typeId          String
  leaveType       LeaveType   @relation(fields: [typeId], references: [id])
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  reason          String?
  status          LeaveStatus @default(PENDING)
  managerComments String?

  reviewedBy String?

  @@index([employeeId, status])
}

model LeaveType {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  requests    LeaveRequest[]
}

// --- Audit Tracking Model ---
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // e.g., "CREATE_EMPLOYEE", "APPROVE_LEAVE"
  targetType String // e.g., "User", "LeaveRequest"
  targetId   String // ID of the record affected
  details    String? // JSON string containing before/after data
  timestamp  DateTime @default(now()) @db.Timestamptz()
}
