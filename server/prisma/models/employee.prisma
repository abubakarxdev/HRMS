enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACTUAL
  INTERN
  PROBATION
}

model Employee {
  id String @id @default(uuid())

  // -- Organizational Links --
  legalEntityId String?
  officeId      String?
  managerId     String?

  // -- Core Identity --
  employeeIdNumber String? @unique
  firstName        String
  lastName         String
  workEmail        String  @unique
  personalEmail    String?
  avatarUrl        String?
  status           String  @default("Active")

  // -- Tenure --
  joiningDate DateTime @db.Date

  // -- JSON Details --
  personalDetails Json?
  bankDetails     Json?

  // -- Relations --
  user        User?
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id])
  office      Office?      @relation(fields: [officeId], references: [id])

  manager      Employee?  @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates Employee[] @relation("ManagerSubordinates")

  contracts        EmploymentContract[]
  educationHistory EducationHistory[]
  workExperience   WorkExperience[]

  attendanceRecords AttendanceRecord[]
  leaveBalances     LeaveBalance[]

  leaveRequests    LeaveRequest[]
  approvedLeaves   LeaveRequest[]    @relation("LeaveApprover")
  payslips         Payslip[]
  issuedDocuments  IssuedDocument[]
  documentRequests DocumentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model EmploymentContract {
  id         String @id @default(uuid())
  employeeId String

  type       ContractType
  position   String
  department String?

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date // For Interns/Contractors

  // MOVED HERE: Specific to this contract engagement
  probationEndDate DateTime? @db.Date

  isActive Boolean @default(false)

  // Compensation
  currency  String
  salary    Decimal  @db.Decimal(12, 2)
  dailyRate Decimal? @db.Decimal(12, 2)

  contractFiles Json?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employment_contracts")
}

model EducationHistory {
  id          String  @id @default(uuid())
  employeeId  String
  degree      String
  institute   String
  year        String
  documentUrl String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("education_history")
}

model WorkExperience {
  id         String    @id @default(uuid())
  employeeId String
  company    String
  title      String
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("work_experience")
}
