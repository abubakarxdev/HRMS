model SalaryConfig {
  id String @id @default(uuid())

  currentMinWage  Decimal  @db.Decimal(12, 2)
  eobiEmpPct      Decimal  @db.Decimal(5, 4)
  eobiEmployerPct Decimal  @db.Decimal(5, 4)
  updatedAt       DateTime @default(now())

  @@map("salary_configs")
}

model TaxBracket {
  id            String @id @default(uuid())
  legalEntityId String
  fiscalYear    String // '2024-2025'

  minIncome  Decimal  @db.Decimal(15, 2)
  maxIncome  Decimal? @db.Decimal(15, 2)
  baseAmount Decimal  @default(0) @db.Decimal(15, 2)
  rate       Decimal  @db.Decimal(5, 4)

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])

  @@map("tax_brackets")
}

model Payslip {
  id         String @id @default(uuid())
  employeeId String
  month      String // '2025-11'

  // -- Financial Snapshots --
  grossSalary   Decimal @db.Decimal(12, 2)
  taxDeduction  Decimal @db.Decimal(12, 2)
  eobiDeduction Decimal @default(0) @db.Decimal(12, 2)
  netSalary     Decimal @db.Decimal(12, 2)
  currency      String

  // -- Context Snapshots --
  designationSnapshot String?
  departmentSnapshot  String?

  status      String    @default("Draft") // Draft, Paid
  paymentDate DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id])

  generatedAt DateTime @default(now())

  @@map("payslips")
}
