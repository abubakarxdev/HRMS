model LegalEntity {
  id              String  @id @default(uuid())
  name            String
  countryCode     String // "US", "PK"
  defaultCurrency String // "USD", "PKR"
  logoUrl         String?

  offices     Office[]
  employees   Employee[]
  taxBrackets TaxBracket[]

  createdAt DateTime @default(now())

  @@map("legal_entities")
}

model Office {
  id            String  @id @default(uuid())
  legalEntityId String
  name          String
  address       String?

  // Default Timezone for everyone in this office (e.g., 'Asia/Karachi')
  timezone String

  employees     Employee[]
  holidays      PublicHoliday[]
  leaveTypes    LeaveType[]
  leavePolicies LeavePolicy[]
  legalEntity   LegalEntity     @relation(fields: [legalEntityId], references: [id])

  createdAt DateTime @default(now())

  @@map("offices")
}

model PublicHoliday {
  id       String @id @default(uuid())
  officeId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  name        String
  description String?
  isOptional  Boolean @default(false)
  isHalfDay   Boolean @default(false)

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, startDate, endDate])
  @@map("public_holidays")
}
